PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=Cluster0

# Set to "production" on Render (or any real deployment). Controls whether cookies are issued
# as Secure + SameSite=None (required for the frontend/backend cross-site cookie to work at all
# in production) vs Secure-less + SameSite=Lax (so login still works over plain http://localhost
# in local dev, where Secure cookies would otherwise be silently dropped by the browser).
NODE_ENV=development

# Public URL this backend is reachable at (used to build links to uploaded audio files in the sheet)
PUBLIC_BASE_URL=http://localhost:5000

# Google Sheets sync — requires a GCP service account with Sheets API access,
# shared as Editor on the target spreadsheet. Left blank, sync is skipped silently.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Comma-separated list of allowed origins (e.g. your Vercel frontend URL). REQUIRED — unlike
# before, leaving this blank now means NO cross-origin browser request is allowed at all (no
# wildcard fallback), including from your own frontend in local dev (e.g.
# http://localhost:5173), since it's a different origin/port from the backend.
CORS_ORIGIN=

# Auth — two separate random long strings, one for short-lived access tokens and one for the
# longer-lived refresh token (kept separate so a leaked access token can never be replayed as a
# refresh token). Generate each with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Encrypts sensitive fields at rest (currently: Submission.serverAccess — real PMS login
# credentials). Must be exactly 32 bytes as a 64-character hex string — a different length will
# throw at encrypt/decrypt time, not silently truncate/pad. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing or rotating this key makes any already-encrypted data permanently unreadable — back it
# up somewhere durable, separate from the database itself.
ENCRYPTION_KEY=

# Google Sign-In — OAuth 2.0 Client ID (Web application) from GCP Console > APIs & Services
# > Credentials. NOT the service account above — this is a separate, public client ID.
# Must match VITE_GOOGLE_CLIENT_ID on the frontend.
GOOGLE_OAUTH_CLIENT_ID=

# Google Chat webhook notifications AND the Google Drive folder id are both configured live by
# an admin from the app's Manage Access > Settings screen (stored in Mongo), not here — nothing
# to set in this file for either. Reuses the service account above; the Drive API just needs to
# be enabled and the target Shared Drive shared with that service account (Editor access).
